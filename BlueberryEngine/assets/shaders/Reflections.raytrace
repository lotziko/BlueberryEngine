#pragma raygeneration ReflectionsRayGeneration
#pragma anyhit0 ReflectionsAnyHit
#pragma closesthit0 ReflectionsClosestHit
#pragma miss0 ReflectionsMiss

#pragma payload_size 16
#pragma attributes_size 8
#pragma ray_recursion_depth 2

#include "Math.hlsl"
#include "nrd/NRD.hlsl"

#define PI 3.14159265358979323846

RaytracingAccelerationStructure _RaytracingAccelerationStructure : register(t0);
Texture2D _ScreenColorTexture : register(t1);
Texture2D _ScreenDepthStencilTexture : register(t2);
Texture2D _ScreenORMTexture : register(t3);
Texture2D _ScreenNormalWSTexture : register(t4);
TextureCube _SkyboxTexture : register(t5);
SamplerState _SkyboxTexture_Sampler : register(s0);
Texture3D _ProbeVolumeTexture0 : register(t6);
Texture3D _ProbeVolumeTexture1 : register(t7);
Texture3D _ProbeVolumeTexture2 : register(t8);
Texture3D _ProbeVolumeTexture3 : register(t9);
Texture3D _ProbeVolumeTexture4 : register(t10);
Texture3D _ProbeVolumeTexture5 : register(t11);
SamplerState _ProbeVolumeTexture_Sampler : register(s1);

RWTexture2D<float4> _RadianceHitDistTexture : register(u0);
RWTexture2D<float3> _NormalRoughnessTexture : register(u1);
RWTexture2D<float> _ViewZTexture : register(u2);

cbuffer ReflectionsCameraData : register(b0)
{
	float4x4 _ProjectionMatrix;
	float4x4 _InverseViewProjectionMatrix;
	float3 _CameraPositionWS;
	uint _FrameIndex;
	uint2 _ViewportSize;
	uint2 _BufferSize;
};

cbuffer ReflectionsLightData : register(b1)
{
	float _HasMainLight;
	float3 _Dummy;
	float3 _MainLightColor;
	float _MainLightHasShadow;
	float3 _MainLightDirection;
	float _HasProbeVolume;
	float4 _ProbeVolumeMin;
	float4 _ProbeVolumeSize;
	float4 _ProbeVolumeInvSize;
	float4 _ProbeVolumeCellSize;
}

typedef BuiltInTriangleIntersectionAttributes Attributes;

struct Payload
{
	float3 color;
	float distance;
};

ByteAddressBuffer _Vertices : register(t0, space1);
ByteAddressBuffer _Indices : register(t1, space1);

cbuffer RTPerMeshData : register(b0, space1)
{
	uint _VertexStride;
	uint _NormalOffset;
	uint _Uv0Offset;
};

cbuffer RTPerMaterialData : register(b1, space1)
{
	uint _BaseMap;
	uint _BaseMap_Sampler;
	uint _ORMMap;
	uint _ORMMap_Sampler;
};

float4 SampleTexture2D(uint textureIndex, uint samplerIndex, float2 uv)
{
	Texture2D<float4> texture = ResourceDescriptorHeap[textureIndex];
	SamplerState sampler = SamplerDescriptorHeap[samplerIndex];
	return texture.SampleLevel(sampler, uv, 0);
}

float3 ClampLuminance(float3 color, float limit)
{
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    return color * min(1.0, limit / max(luminance, 1e-6));
}

float3 SampleSkybox(float3 direction)
{
	return ClampLuminance(_SkyboxTexture.SampleLevel(_SkyboxTexture_Sampler, direction, 0).rgb/* * pow(2, 2.2)*/, 5);
}

uint3 GetIndices()
{
	uint triangleIndex = PrimitiveIndex();
	return uint3(_Indices.Load((triangleIndex * 3 + 0) * 4), _Indices.Load((triangleIndex * 3 + 1) * 4), _Indices.Load((triangleIndex * 3 + 2) * 4));
}

float3 GetBarycentrics(float2 attributeBarycentrics)
{
	return float3(1 - attributeBarycentrics.x - attributeBarycentrics.y, attributeBarycentrics.x, attributeBarycentrics.y);
}

float3 GetNormal(uint3 indices, float3 barycentrics)
{
    float3 n0 = asfloat(_Vertices.Load3(indices.x * _VertexStride + _NormalOffset));
    float3 n1 = asfloat(_Vertices.Load3(indices.y * _VertexStride + _NormalOffset));
    float3 n2 = asfloat(_Vertices.Load3(indices.z * _VertexStride + _NormalOffset));
    return normalize(n0 * barycentrics.x + n1 * barycentrics.y + n2 * barycentrics.z);
}

float2 GetUv(uint3 indices, float3 barycentrics)
{
	float2 uv0 = asfloat(_Vertices.Load2(indices.x * _VertexStride + _Uv0Offset));
	float2 uv1 = asfloat(_Vertices.Load2(indices.y * _VertexStride + _Uv0Offset));
	float2 uv2 = asfloat(_Vertices.Load2(indices.z * _VertexStride + _Uv0Offset));
	return uv0 * barycentrics.x + uv1 * barycentrics.y + uv2 * barycentrics.z;
}

float HaltonRadicalInverse(uint index, uint base)
{
    float result = 0.0f;
    float invBase = 1.0f / (float)base;
    float fraction = invBase;
    
    while (index > 0u)
    {
        result += (float)(index % base) * fraction;
        fraction *= invBase;
        index /= base;
    }
    
    return result;
}

float2 Halton23(uint index)
{
    return float2(HaltonRadicalInverse(index, 2u), HaltonRadicalInverse(index, 3u));
}

float2 HashToFloat2(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.xx + p3.yz) * p3.zy);
}

float DepthToViewZ(float depth, float4x4 projection)
{
    return (projection[2][3] - depth * projection[3][3]) / (depth * projection[3][2] - projection[2][2]);
}

float CalculateDistributionGGX(float NDotH, float roughness)
{
	float a = roughness * roughness;
	float a2 = a * a;
	float NDotH2 = NDotH * NDotH;

	float num = a2;
	float denom = (NDotH2 * (a2 - 1.0) + 1.0);
	denom = PI * denom * denom;

	return num / denom;
}

float CalculateGeometrySchlickGGX(float NDotV, float roughness)
{
	float r = (roughness + 1.0);
	float k = (r * r) / 8.0;

	float num = NDotV;
	float denom = NDotV * (1.0 - k) + k;

	return num / denom;
}

float3 CalculateFresnelSchlick(float LDotH, float3 reflectance)
{
	return reflectance + (1.0 - reflectance) * pow(1.0 - LDotH, 5);
}

float3 CalculateDirectSpecular(float3 normalWS, float3 viewDirectionWS, float3 lightDirectionWS, float3 lightColor, float attenuation, float falloff, float3 reflectance, float roughness)
{
	float3 floatAngleDirWS = normalize(lightDirectionWS.xyz + viewDirectionWS.xyz);
	float LDotH = max(0, dot(lightDirectionWS.xyz, floatAngleDirWS.xyz));
	float NDotH = max(0, dot(normalWS.xyz, floatAngleDirWS.xyz));
	float NDotL = max(0, dot(normalWS.xyz, lightDirectionWS.xyz));
	float NDotV = max(0, dot(normalWS.xyz, viewDirectionWS.xyz));

	float NDF = CalculateDistributionGGX(NDotH, roughness);
	float G = CalculateGeometrySchlickGGX(NDotV, roughness) * CalculateGeometrySchlickGGX(NDotL, roughness);
	float3 F = CalculateFresnelSchlick(LDotH, reflectance);

	float3 numerator = NDF * G * F;
	float denominator = 4.0 * NDotV * NDotL + 0.0001;

	return (numerator / denominator) * NDotL * lightColor * attenuation * falloff;
}

[shader("raygeneration")]
void ReflectionsRayGeneration()
{
	uint2 sourcePixel = DispatchRaysIndex().xy;
	float2 texcoord = (float2(sourcePixel) + 0.5) / float2(_ViewportSize);
	float2 positionNdc = texcoord * 2.0 - 1.0;
	positionNdc.y = -positionNdc.y;
	float depth = _ScreenDepthStencilTexture.Load(uint3(sourcePixel.xy, 0)).r;
	float viewZ = DepthToViewZ(depth, _ProjectionMatrix);
	float3 normalWS = DecodeNormalOctahedral(_ScreenNormalWSTexture.Load(uint3(sourcePixel.xy, 0)).rg);
	float3 orm = _ScreenORMTexture.Load(uint3(sourcePixel.xy, 0)).rgb;
	float roughness = orm.g;
	float metallic = orm.b;

	_NormalRoughnessTexture[sourcePixel] = NRD_FrontEnd_PackNormalAndRoughness(normalWS, roughness, 0);
	_ViewZTexture[sourcePixel] = depth < 1.0 ? viewZ : NRD_INF;

	const uint specCheckerboard = 0u;
	uint checkerboard = (sourcePixel.x ^ sourcePixel.y ^ _FrameIndex) & 1u;

	if (checkerboard != specCheckerboard)
	{
		return;
	}

	uint2 outputPixel = uint2(sourcePixel.x >> 1, sourcePixel.y);

	if (depth >= 1.0)
	{
		_RadianceHitDistTexture[outputPixel] = 0.0;
		return;
	}

	float4 positionCS = float4(positionNdc, depth, 1.0);
	float4 positionWS = mul(_InverseViewProjectionMatrix, positionCS);
	positionWS /= positionWS.w;
	float3 viewDirectionWS = normalize(positionWS.xyz - _CameraPositionWS);

	float3 V = -viewDirectionWS;
	float NdotV = saturate(dot(normalWS, V));

	float3 baseColor = _ScreenColorTexture.Load(uint3(sourcePixel, 0)).rgb;
	float3 albedo = (1 - metallic) * baseColor;
	float3 reflectance = 0.04;
	reflectance = lerp(reflectance, baseColor, metallic);

	float3 sampleWeight;
	bool validSample = NdotV > 0.0;

	float3 rayDirectionWS;
	if (roughness > 0.001)
	{
		float2 Xi = frac(Halton23(_FrameIndex + 1u) + HashToFloat2(sourcePixel.xy));
		float4 H = ImportanceSampleGGX(Xi, normalWS, roughness);
		rayDirectionWS = reflect(viewDirectionWS, H.xyz);

		float VdotH = dot(V, H.xyz);
		float NdotL = dot(normalWS, rayDirectionWS);
		float NdotH = dot(normalWS, H.xyz);

		validSample = NdotV > 0.0 && VdotH > 1e-5 && NdotL > 0.0 && NdotH > 0.0 && H.w > 0.0;

		if (validSample)
		{
			float pdfL = H.w / (4.0 * VdotH);
			float D = CalculateDistributionGGX(NdotH, roughness);
			float G = CalculateGeometrySchlickGGX(NdotV, roughness) * CalculateGeometrySchlickGGX(NdotL, roughness);
			float3 F = CalculateFresnelSchlick(VdotH, reflectance);

			float3 specularBRDF = D * G * F / max(4.0 * NdotV * NdotL, 1e-6);
			sampleWeight = specularBRDF * NdotL / max(pdfL, 1e-6);
		}
		else
		{
			sampleWeight = 0;
		}
	}
	else
	{
		rayDirectionWS = reflect(viewDirectionWS, normalWS);
		sampleWeight = CalculateFresnelSchlick(NdotV, reflectance);
	}

	RayDesc ray;
	ray.Origin = positionWS + normalWS * 0.001;
	ray.Direction = rayDirectionWS;
	ray.TMin = 0.001;
	ray.TMax = 10000.0;

	Payload payload;
	payload.color = float3(0, 0, 0);
	payload.distance = 1;

	TraceRay(_RaytracingAccelerationStructure, RAY_FLAG_CULL_BACK_FACING_TRIANGLES , ~0, 0, 1, 0, ray, payload);
	float normHitDist = REBLUR_FrontEnd_GetNormHitDist(payload.distance, viewZ, float3(3.0, 0.1, 20.0), roughness);
	_RadianceHitDistTexture[outputPixel] = REBLUR_FrontEnd_PackRadianceAndNormHitDist(payload.color, normHitDist, true);
}

[shader("anyhit")]
void ReflectionsAnyHit(inout Payload payload : SV_RayPayload, in Attributes attributes : SV_IntersectionAttributes)
{
	float2 uv = GetUv(GetIndices(), GetBarycentrics(attributes.barycentrics));
	float4 color = SampleTexture2D(_BaseMap, _BaseMap_Sampler, uv);
	if (color.a < 0.125)
	{
		 IgnoreHit();
	}
}

float3 CalculateDirectDiffuse(float3 normalWS, float3 viewDirectionWS, float3 lightDirectionWS, float3 lightColor, float attenuation, float falloff, float roughness)//(float3 normalWS, float3 lightDirectionWS, float3 lightColor, float attenuation)
{
	float NdotL = saturate(dot(normalWS, lightDirectionWS));
	float NdotV = saturate(dot(normalWS, viewDirectionWS));
	float LdotH = saturate(dot(lightDirectionWS, normalize(lightDirectionWS.xyz + viewDirectionWS.xyz)));

	float FD90 = 0.5 + 2.0 * roughness * LdotH * LdotH;
	float lightScatter = 1.0 + (FD90 - 1.0) * pow(1.0 - NdotL, 5);
	float viewScatter = 1.0 + (FD90 - 1.0) * pow(1.0 - NdotV, 5);

	return (lightColor * attenuation * falloff) * (lightScatter * viewScatter) * (1.0 / PI) * NdotL;
}

float3 SampleProbeVolume(float3 positionWS, float3 normalWS)
{
	// TODO
	return 0;
}

[shader("closesthit")]
void ReflectionsClosestHit(inout Payload payload : SV_RayPayload, in Attributes attributes : SV_IntersectionAttributes)
{
	uint3 indices = GetIndices();
    float3 barycentrics = GetBarycentrics(attributes.barycentrics);
	float2 uv = GetUv(indices, barycentrics);
	float3 orm = SampleTexture2D(_ORMMap, _ORMMap_Sampler, uv);
	float roughness = orm.g;
	float metallic = orm.b;
	
	float3 baseColor = SampleTexture2D(_BaseMap, _BaseMap_Sampler, uv);
	float3 albedo = (1 - metallic) * baseColor;
	float3 reflectance = 0.04;
	reflectance = lerp(reflectance, baseColor, metallic);

	float3 normalOS = GetNormal(indices, barycentrics);
	float3 positionWS = WorldRayOrigin() + RayTCurrent() * WorldRayDirection();
	float3 normalWS = normalize(mul(normalOS, (float3x3)WorldToObject3x4()));
	float3 viewDirectionWS = normalize(WorldRayOrigin() - positionWS); 

	float3 directDiffuseTerm = 0;
	float3 directSpecularTerm = 0;
	float3 indirectDiffuseTerm = 0;
	// Main light
	if (_HasMainLight)
	{
		float3 lightDirectionWS = _MainLightDirection;
		float shadowAttenuation = 1;
		if (_MainLightHasShadow)
		{
			RayDesc visibilityRay;
			visibilityRay.Origin = positionWS + normalWS * 0.001;
			visibilityRay.Direction = lightDirectionWS;
			visibilityRay.TMin = 0.f;
			visibilityRay.TMax = 10000.0;

			Payload visibilityPayload;
			visibilityPayload.color = 0;
			visibilityPayload.distance = 0;

			TraceRay(_RaytracingAccelerationStructure, RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER, ~0, 0, 1, 0, visibilityRay, visibilityPayload);
			shadowAttenuation = visibilityPayload.distance == NRD_INF ? 1.0 : 0.0;
		}
		directDiffuseTerm += CalculateDirectDiffuse(normalWS, viewDirectionWS, lightDirectionWS, _MainLightColor, shadowAttenuation, 1.0f, roughness);
		directSpecularTerm += CalculateDirectSpecular(normalWS, viewDirectionWS, lightDirectionWS, _MainLightColor, shadowAttenuation, 1.0f, reflectance, roughness);
	}
	
	// Probe volume
	if (_HasProbeVolume)
	{
		indirectDiffuseTerm += SampleProbeVolume(positionWS, normalWS);
	}
	
	payload.color.rgb = (directDiffuseTerm + indirectDiffuseTerm) * albedo + directSpecularTerm;
	payload.distance = RayTCurrent();
}

[shader("miss")]
void ReflectionsMiss(inout Payload payload : SV_RayPayload)
{
	float3 rayDir = WorldRayDirection();
	payload.color.rgb += SampleSkybox(normalize(rayDir));
	payload.distance = NRD_INF;
}